# ═══════════════════════════════════════════════════════════════════════════════
#  BERALSHOPP — Variables d'environnement
#
#  UTILISATION
#    1. Copier ce fichier en `.env.local`   →   cp .env.example .env.local
#    2. Renseigner les valeurs réelles
#    3. `.env.local` est ignoré par Git et ne doit JAMAIS être commité
#
#  ⚠️ AUCUNE clé secrète ne doit apparaître dans une variable NEXT_PUBLIC_*.
#     Tout ce qui commence par NEXT_PUBLIC_ est envoyé au navigateur et visible
#     par n'importe quel visiteur. Les clés Pesapal restent côté serveur.
# ═══════════════════════════════════════════════════════════════════════════════

# ─────────────────────────────── Base de données ───────────────────────────────

# Connexion utilisée par l'application. Passe par le pooler (PgBouncer côté Neon).
DATABASE_URL="postgresql://user:password@host/beralshopp?sslmode=verify-full"

# Connexion DIRECTE, sans pooler. Utilisée uniquement par les migrations Prisma.
# Un pooler transactionnel casse les instructions DDL — ne pas mettre la même URL.
DIRECT_URL="postgresql://user:password@host/beralshopp?sslmode=verify-full"

# Amorçage des catégories de démonstration. À laisser à `false` en production.
SEED_DEMO_DATA="false"

# ─────────────────────────────── Application ───────────────────────────────

NODE_ENV="development"

# URL publique du site, sans barre oblique finale.
# Sert à construire les URL de retour envoyées à Pesapal — une erreur ici casse
# le retour du client après paiement.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Secret de signature des sessions et des cookies.
# Générer avec :  openssl rand -base64 32
AUTH_SECRET=""

# Secret protégeant les tâches planifiées (/api/v1/taches).
# DIFFÉRENT de AUTH_SECRET. Sans lui, la route refuse tout appel — et le stock des
# commandes impayées ne sera jamais libéré.
CRON_SECRET=""

# ─────────────────────────────── Paiement Pesapal ───────────────────────────────
#
# Obtenus dans le tableau de bord marchand Pesapal.
# Bac à sable  : https://cybqa.pesapal.com/pesapalv3/api/
# Production   : https://pay.pesapal.com/v3/api/
#
# ⚠️ Développer et valider les CINQ scénarios sur le bac à sable avant de basculer :
#    paiement réussi, échoué, annulé, en attente, remboursé.

PESAPAL_CONSUMER_KEY=""
PESAPAL_CONSUMER_SECRET=""

# "sandbox" ou "production"
PESAPAL_ENVIRONMENT="sandbox"

# Identifiant de l'URL de notification, retourné par RegisterIPN.
# À enregistrer une seule fois par environnement, puis à recopier ici.
PESAPAL_IPN_ID=""

# ─────────────────────────────── Redis (cache, sessions) ───────────────────────────────

REDIS_URL=""

# ─────────────────────────────── Images (Cloudflare R2) ───────────────────────────────

R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="beralshopp-media"

# Domaine public de diffusion des images. Doit être déclaré dans next.config.ts.
NEXT_PUBLIC_IMAGE_HOST=""

# ─────────────────────────────── Notifications ───────────────────────────────

RESEND_API_KEY=""
EMAIL_FROM="Beralshopp <commandes@beralshopp.com>"

# SMS / WhatsApp — activés en V2.
SMS_PROVIDER_API_KEY=""
WHATSAPP_API_TOKEN=""

# ─────────────────────────────── Taux de change ───────────────────────────────

# Fournisseur de taux. Vide = conversion multi-devises désactivée (comportement V1).
FX_PROVIDER_API_KEY=""

# Marge de sécurité appliquée aux conversions, en pourcentage.
FX_MARGIN_PERCENT="3"

# ─────────────────────────────── Contact public ───────────────────────────────
# Ces valeurs sont visibles par les visiteurs : c'est voulu.


# ─────────────────────────────── Supervision ───────────────────────────────

SENTRY_DSN=""
