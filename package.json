{
  "name": "beralshopp",
  "version": "0.1.0",
  "private": true,
  "description": "Beralshopp — plateforme e-commerce africaine",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start": "turbo run start",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,css,yaml,yml}\"",
    "db:generate": "pnpm --filter @beralshopp/db run generate",
    "db:migrate": "pnpm --filter @beralshopp/db run migrate",
    "db:push": "pnpm --filter @beralshopp/db run push",
    "db:studio": "pnpm --filter @beralshopp/db run studio",
    "db:seed": "pnpm --filter @beralshopp/db run seed",
    "db:verify": "pnpm --filter @beralshopp/db run verify",
    "db:reconcile": "pnpm --filter @beralshopp/db run reconcile",
    "db:admin": "pnpm --filter @beralshopp/core run admin",
    "pesapal:check": "pnpm --filter @beralshopp/core run pesapal:check",
    "pesapal:ipn": "pnpm --filter @beralshopp/core run pesapal:ipn",
    "preflight": "pnpm --filter @beralshopp/core run preflight",
    "db:import": "pnpm --filter @beralshopp/db run import"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.10.7",
    "typescript": "^5.9.3"
  }
}
